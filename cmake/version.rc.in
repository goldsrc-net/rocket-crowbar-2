		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "goldsrc.net"
			VALUE "FileDescription", "@MOD_RC_DESCRIPTION@"
			VALUE "FileVersion", "@MOD_VERSION_MAJOR@.@MOD_VERSION_MINOR@.@MOD_VERSION_PATCH@.@MOD_VERSION_BUILD@"
			VALUE "InternalName", "@MOD_RC_FILENAME@"
			VALUE "OriginalFilename", "@MOD_RC_FILENAME@"
			VALUE "ProductName", "@MOD_PRODUCT@"
			VALUE "ProductVersion", "@MOD_VERSION_FULL@ (@MOD_VERSION_HASH@)"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
