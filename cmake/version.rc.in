// Generated by cmake/Version.cmake: the version resource (Explorer: Properties, Details).
// Numeric constants instead of <winres.h>, so llvm-rc and rc.exe both take it without an SDK include.
1 VERSIONINFO
FILEVERSION @MOD_VERSION_MAJOR@,@MOD_VERSION_MINOR@,@MOD_VERSION_PATCH@,@MOD_VERSION_BUILD@
PRODUCTVERSION @MOD_VERSION_MAJOR@,@MOD_VERSION_MINOR@,@MOD_VERSION_PATCH@,@MOD_VERSION_BUILD@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
