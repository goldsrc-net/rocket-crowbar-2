# Allow Half-Life-specific files that would otherwise be ignored
!lib/public/SDL2.lib
!utils/procinfo/lib/win32_vc6/procinfo.lib
!utils/vgui/lib/win32_vc16/vgui.lib

# CMake build folder
build

# per-arch build dirs
build-*/
build_*/

# WIP decompiler output (not committed until it becomes real source)
recovered/

# session working files (decompiles, RE notes)
scratchpad/

# python bytecode
__pycache__/
*.pyc

# scripts/package.sh output
dist/

# The original mod's own libraries (reference/README.md): not ours to publish
/reference/rc2.dll
/reference/client.dll
/reference/beta1/
